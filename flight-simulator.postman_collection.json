{
	"info": {
		"_postman_id": "4904dd1f-1b57-41f0-af8b-4291201b8a96",
		"name": "Flight Simulator",
		"description": "Complete test collection for the Flight Status Simulator API.\n\nWorkflow:\n\n1. Run 'Start Flight' — the flightId is auto-saved to the collection variable\n    \n2. Run 'Get Flight Status' to see current phase + latest metrics\n    \n3. Run 'List All Flights' to see all active/completed flights\n    \n4. Run 'Get Flight History' to see all recorded metric snapshots\n    \n5. Open 'Stream Flight Metrics (SSE)' in a browser or curl\n    \n\nVariables:\n\n- baseUrl → [http://localhost:8080](http://localhost:8080)\n    \n- flightId → auto-set after 'Start Flight'",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "7781790"
	},
	"item": [
		{
			"name": "Flights",
			"item": [
				{
					"name": "Start Flight",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"origin\": \"LAX\",\n  \"destination\": \"JFK\",\n  \"airline\": \"Simulated Airlines\",\n  \"flightNumber\": \"SA003\",\n  \"timeMultiplier\": 120\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/flights",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"flights"
							]
						},
						"description": "Starts a new LAX → JFK flight simulation.\n\nThe `flightId` from the response is automatically saved as a collection variable and used by all subsequent requests."
					},
					"response": []
				},
