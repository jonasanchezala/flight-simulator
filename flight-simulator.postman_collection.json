					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream"
							},
							{
								"key": "Cache-Control",
								"value": "no-cache"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/flights/{{flightId}}/stream",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"flights",
								"{{flightId}}",
								"stream"
							]
						},
						"description": "Opens a Server-Sent Events stream for the flight.\n\nPostman will show the raw event stream. Each event has:\n- `id`    → simulatedElapsedMinutes (use as Last-Event-ID to reconnect)\n- `event` → METRICS or COMPLETED\n- `data`  → JSON metrics payload\n\nFor a better SSE experience use curl:\n  curl -N http://localhost:8080/flights/<id>/stream\n\nOr open the URL directly in a browser."
					},
					"response": []
				}
